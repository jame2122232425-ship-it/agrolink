# Copy this file to .env and replace the placeholder values with your own local secrets.
# Keep .env private and do not commit it to source control.
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=agrolink
POSTGRES_USER=agrolink_user
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# For hosted PostgreSQL (for example Supabase), DATABASE_URL takes precedence over POSTGRES_*.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# AI credentials are read by Django only; never add them to frontend/.env.
AI_ENABLED=True
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_MOCK_MODE=False
AI_REQUEST_TIMEOUT_SECONDS=30
